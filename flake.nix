{
  description = "NixOS configuration with Home Manager";

  # ── Flake inputs ─────────────────────────────────────────────────────
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    # Patched kernel modules for the MediaTek MT7927 wifi card.
    mt7927.url = "github:cmspam/mt7927-nixos";

    # Deliberately NOT following nixpkgs
    noctalia.url = "github:noctalia-dev/noctalia";

    noctalia-greeter = {
      url = "github:noctalia-dev/noctalia-greeter";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    nix-flatpak.url = "github:gmodena/nix-flatpak";
  };

  # ── Flake outputs ────────────────────────────────────────────────────
  # Produces a single NixOS config "ghost".
  outputs = inputs @ {
    self,
    nixpkgs,
    home-manager,
    mt7927,
    noctalia,
    noctalia-greeter,
    nix-flatpak,
    ...
  }: let
    flakePath = "/home/bws428/.nixos-config";
  in {
    nixosConfigurations.ghost = nixpkgs.lib.nixosSystem {
      specialArgs = {inherit flakePath mt7927;};

      modules = [
        # ── Hardware ───────────────────────────────────────────────
        # Hardware config is auto-generated by `nixos-generate-config`
        ./hardware-configuration.nix
        mt7927.nixosModules.default
        nix-flatpak.nixosModules.nix-flatpak
        noctalia-greeter.nixosModules.default

        # ── System modules ─────────────────────────────────────────
        ./modules/boot.nix
        ./modules/users.nix
        ./modules/locale.nix
        ./modules/nvidia.nix
        ./modules/networking.nix
        ./modules/mt7927-wifi.nix
        ./modules/bluetooth.nix
        ./modules/services.nix
        ./modules/llms.nix
        ./modules/storage.nix
        ./modules/backups.nix
        ./modules/upgrade.nix

        # ── Desktop environments ───────────────────────────────────
        ./modules/desktop.nix
        ./modules/greeter.nix

        # ── Fonts & packages ───────────────────────────────────────
        ./modules/fonts.nix
        ./modules/packages.nix

        # ── Development environment ────────────────────────────────
        ./modules/dev.nix

        # ── Home Manager ───────────────────────────────────────────
        home-manager.nixosModules.home-manager
        {
          home-manager.useGlobalPkgs = true;
          home-manager.useUserPackages = true;
          home-manager.backupFileExtension = "hm-bak";
          home-manager.extraSpecialArgs = {inherit flakePath;};
          home-manager.users.bws428 = {
            imports = [
              noctalia.homeModules.default
              ./home.nix
            ];
          };
        }
      ];
    };
  };
}
